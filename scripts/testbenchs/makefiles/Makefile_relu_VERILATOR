# ==============================================================================
# Makefile - ReLU com Verilator + cobertura LCOV/HTML
# Projeto: CNN
# ==============================================================================

SHELL := /bin/bash
.DEFAULT_GOAL := all


# ==============================================================================
# FERRAMENTAS
# ==============================================================================

VERILATOR          ?= verilator
VERILATOR_COVERAGE ?= verilator_coverage
LCOV                ?= lcov
GENHTML             ?= genhtml
GTKWAVE             ?= gtkwave
SURFER              ?= surfer


# ==============================================================================
# DIRETÓRIOS
# ==============================================================================

# Este Makefile é esperado em:
#   <projeto>/scripts/testbenchs/makefiles/Makefile_relu_VERILATOR
MAKEFILE_DIR := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PROJECT_ROOT := $(abspath $(MAKEFILE_DIR)/../../..)

RTL_DIR := $(PROJECT_ROOT)/src/ReLU
TB_DIR  := $(PROJECT_ROOT)/testbenchs/ReLU/doc_verif/RELU

RESULTS_ROOT ?= $(PROJECT_ROOT)/results_tb
RESULTS_DIR  := $(RESULTS_ROOT)/ReLU

# Builds do Verilator separados para execução normal e cobertura
OBJ_DIR     := $(RESULTS_DIR)/obj_dir
OBJ_DIR_COV := $(RESULTS_DIR)/obj_dir_cov

# Waveform
WAVE := $(RESULTS_DIR)/ReLU_tb.vcd

# Logs
LOG_DIR         := $(RESULTS_DIR)/logs
LINT_LOG        := $(LOG_DIR)/lint.log
COMPILE_LOG     := $(LOG_DIR)/compile.log
SIM_LOG         := $(LOG_DIR)/simulation.log
COMPILE_COV_LOG := $(LOG_DIR)/compile_coverage.log
SIM_COV_LOG     := $(LOG_DIR)/simulation_coverage.log

# Cobertura
COV_DIR      := $(RESULTS_DIR)/coverage
COV_DAT      := $(COV_DIR)/relu_coverage.dat
COV_INFO_RAW := $(COV_DIR)/relu_coverage_raw.info
COV_INFO_RTL := $(COV_DIR)/relu_coverage.info
COV_HTML     := $(COV_DIR)/html

# Lint
LINT_WAIVER     ?=
LINT_WAIVER_OPT := $(if $(strip $(LINT_WAIVER)),$(LINT_WAIVER),)
LINT_WAIVER_OUT ?= $(RESULTS_DIR)/verilator_lint.vlt


# ==============================================================================
# PROJETO ReLU
# ==============================================================================

# Nome do módulo declarado dentro de testbench.sv
TOP := testbench

# Nome do módulo RTL declarado dentro de ReLU.sv
RTL_TOP := ReLU

RTL := $(RTL_DIR)/ReLU.sv
TB  := $(TB_DIR)/testbench.sv

# Argumentos opcionais passados ao executável da simulação.
# Exemplo:
#   make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR run RUN_ARGS="+ALGUM_ARG"
RUN_ARGS ?=

# Argumento necessário para o Verilator salvar a cobertura.
COV_RUN_ARGS := $(RUN_ARGS) +verilator+coverage+file+$(COV_DAT)


# ==============================================================================
# PARALELISMO
# ==============================================================================

JOBS ?= $(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)


# ==============================================================================
# INCLUDES
# ==============================================================================

INC = \
	+incdir+$(TB_DIR) \
	+incdir+$(RTL_DIR) \
	+incdir+$(PROJECT_ROOT)/src


# ==============================================================================
# FLAGS DO VERILATOR
# ==============================================================================

VFLAGS_COMMON = \
	-sv \
	--binary \
	--timing \
	-j $(JOBS) \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	--trace-fst \
	$(INC) \
	--top-module $(TOP)

# Build normal
VFLAGS = \
	$(VFLAGS_COMMON) \
	--Mdir $(OBJ_DIR)

# Build instrumentado para cobertura
VFLAGS_COV = \
	$(VFLAGS_COMMON) \
	--coverage \
	--Mdir $(OBJ_DIR_COV)

# Lint da bancada + RTL
LINT_FLAGS = \
	-sv \
	--lint-only \
	--timing \
	-j $(JOBS) \
	-Wall \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	$(INC) \
	--top-module $(TOP)

# Lint apenas do RTL ReLU
LINT_RTL_FLAGS = \
	-sv \
	--lint-only \
	--timing \
	-j $(JOBS) \
	-Wall \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	+incdir+$(RTL_DIR) \
	--top-module $(RTL_TOP)


# ==============================================================================
# TARGETS
# ==============================================================================

.PHONY: all \
	check_verilator check_tools check_html_tools check_files check_lint_waiver \
	lint lint_rtl lint_waiver \
	compile run compile_cov run_cov \
	lcov_raw lcov_rtl coverage_summary html_rtl coverage \
	waves surf clean help

# Mantém o mesmo comportamento do modelo: make gera o relatório completo.
all: coverage


# ==============================================================================
# VERIFICAÇÕES
# ==============================================================================

check_verilator:
	@command -v $(VERILATOR) >/dev/null 2>&1 || \
	( echo "ERRO: verilator nao encontrado no PATH"; exit 1 )

check_tools:
	@command -v $(VERILATOR) >/dev/null 2>&1 || \
	( echo "ERRO: verilator nao encontrado no PATH"; exit 1 )
	@command -v $(VERILATOR_COVERAGE) >/dev/null 2>&1 || \
	( echo "ERRO: verilator_coverage nao encontrado no PATH"; exit 1 )
	@command -v $(LCOV) >/dev/null 2>&1 || \
	( echo "ERRO: lcov nao encontrado no PATH"; exit 1 )

check_html_tools:
	@command -v $(GENHTML) >/dev/null 2>&1 || \
	( echo "ERRO: genhtml nao encontrado no PATH (instale o pacote lcov)"; exit 1 )

check_files:
	@test -f "$(RTL)" || \
	( echo "ERRO: RTL da ReLU nao encontrado:"; echo "$(RTL)"; exit 1 )
	@test -f "$(TB)" || \
	( echo "ERRO: testbench da ReLU nao encontrado:"; echo "$(TB)"; exit 1 )

check_lint_waiver:
	@if [ -n "$(LINT_WAIVER)" ]; then \
		test -f "$(LINT_WAIVER)" || \
		( echo "ERRO: arquivo de waiver nao encontrado: $(LINT_WAIVER)"; exit 1 ); \
	fi


# ==============================================================================
# LINT
# ==============================================================================

lint: check_verilator check_files check_lint_waiver
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(LINT_WAIVER_OPT) $(LINT_FLAGS) $(RTL) $(TB) \
		2>&1 | tee "$(LINT_LOG)"

lint_rtl: check_verilator check_files check_lint_waiver
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(LINT_WAIVER_OPT) $(LINT_RTL_FLAGS) $(RTL) \
		2>&1 | tee "$(LINT_LOG)"

lint_waiver: check_verilator check_files
	@mkdir -p "$(RESULTS_DIR)"
	$(VERILATOR) $(LINT_FLAGS) --waiver-output "$(LINT_WAIVER_OUT)" $(RTL) $(TB)
	@echo "Waiver inicial gerado em: $(LINT_WAIVER_OUT)"


# ==============================================================================
# SIMULAÇÃO NORMAL
# ==============================================================================

compile: lint check_tools
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(VFLAGS) $(RTL) $(TB) \
		2>&1 | tee "$(COMPILE_LOG)"

run: compile
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Executando ReLU..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	cd "$(RESULTS_DIR)" && "$(OBJ_DIR)/V$(TOP)" $(RUN_ARGS) \
		2>&1 | tee "$(SIM_LOG)"


# ==============================================================================
# SIMULAÇÃO COM COBERTURA
# ==============================================================================

compile_cov: check_tools check_files
	@mkdir -p "$(RESULTS_DIR)" "$(COV_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(VFLAGS_COV) $(RTL) $(TB) \
		2>&1 | tee "$(COMPILE_COV_LOG)"

run_cov: compile_cov
	@mkdir -p "$(RESULTS_DIR)" "$(COV_DIR)" "$(LOG_DIR)"
	@rm -f "$(COV_DAT)" "$(COV_INFO_RAW)" "$(COV_INFO_RTL)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Executando ReLU com cobertura..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	cd "$(RESULTS_DIR)" && "$(OBJ_DIR_COV)/V$(TOP)" $(COV_RUN_ARGS) \
		2>&1 | tee "$(SIM_COV_LOG)"


# ==============================================================================
# RELATÓRIO DE COBERTURA
# ==============================================================================

# Converte o arquivo nativo do Verilator para LCOV.
lcov_raw: run_cov
	$(VERILATOR_COVERAGE) --write-info "$(COV_INFO_RAW)" "$(COV_DAT)"
	@echo "LCOV bruto gerado em: $(COV_INFO_RAW)"

# Mantém no relatório somente o RTL da ReLU.
lcov_rtl: lcov_raw
	$(LCOV) \
		--extract "$(COV_INFO_RAW)" "$(RTL_DIR)/*" \
		-o "$(COV_INFO_RTL)"
	@echo "LCOV RTL-only gerado em: $(COV_INFO_RTL)"

# Resumo de cobertura no terminal.
coverage_summary: lcov_rtl
	$(LCOV) --summary "$(COV_INFO_RTL)"

# Relatório HTML navegável.
html_rtl: coverage_summary check_html_tools
	@rm -rf "$(COV_HTML)"
	@mkdir -p "$(COV_HTML)"
	$(GENHTML) \
		--flat \
		--legend \
		--prefix "$(PROJECT_ROOT)/" \
		--source-directory "$(PROJECT_ROOT)" \
		-o "$(COV_HTML)" \
		"$(COV_INFO_RTL)"
	@echo ""
	@echo "========================================"
	@echo "[OK] Relatorio de cobertura da ReLU"
	@echo "========================================"
	@echo ""
	@echo "HTML:"
	@echo "$(COV_HTML)/index.html"
	@echo ""

coverage: html_rtl


# ==============================================================================
# WAVEFORM
# ==============================================================================

waves: run
	@if [ -f "$(WAVE)" ]; then \
		$(GTKWAVE) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi

surf: run
	@if [ -f "$(WAVE)" ]; then \
		$(SURFER) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi


# ==============================================================================
# LIMPEZA
# ==============================================================================

clean:
	@echo "[CLEAN] Removendo resultados Verilator da ReLU..."
	@rm -rf "$(RESULTS_DIR)"
	@echo "[OK] Resultados removidos."


# ==============================================================================
# AJUDA
# ==============================================================================

help:
	@echo ""
	@echo "Makefile - ReLU / Verilator"
	@echo ""
	@echo "Comandos:"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR"
	@echo "      Executa cobertura completa e gera HTML"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR lint"
	@echo "      Lint da bancada + RTL"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR lint_rtl"
	@echo "      Lint apenas de src/ReLU/ReLU.sv"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR run"
	@echo "      Compila e executa sem cobertura"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR coverage"
	@echo "      Gera cobertura LCOV + HTML"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR waves"
	@echo "      Executa e abre dump.fst no GTKWave"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR surf"
	@echo "      Executa e abre dump.fst no Surfer"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_relu_VERILATOR clean"
	@echo "      Remove results_tb/ReLU"
	@echo ""
