# CNN_top / Verilator: comparacao em caixa preta e cobertura estrutural de src.
SHELL := /bin/bash
.DEFAULT_GOAL := all

THIS_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
PROJECT_ROOT := $(abspath $(dir $(THIS_MAKEFILE))/../../..)
RTL_DIR ?= $(PROJECT_ROOT)/src
TB := $(PROJECT_ROOT)/testbenchs/CNN_top/testbench.sv
TOP := testbench
CONTROL := $(PROJECT_ROOT)/scripts/testbenchs/verilator/cnn_top_coverage.vlt
COV_HELPER := $(PROJECT_ROOT)/scripts/testbenchs/verilator/cnn_top_coverage.cpp
COV_SPLITTER := $(PROJECT_ROOT)/scripts/testbenchs/verilator/split_cnn_coverage.py

# Entradas opacas entregues ao compilador, com uma unica copia de cada modulo.
DUT_FILES ?= \
	$(RTL_DIR)/CNN.sv \
	$(RTL_DIR)/ConvLayer.sv \
	$(RTL_DIR)/FeatureMap.sv \
	$(RTL_DIR)/Convolution/Convolution.sv \
	$(RTL_DIR)/DotProduct/DotProduct.sv \
	$(RTL_DIR)/FCLayer.sv \
	$(RTL_DIR)/Neuron.sv \
	$(RTL_DIR)/Quantizer.sv \
	$(RTL_DIR)/ReLU/ReLU.sv \
	$(RTL_DIR)/MaxPooling.sv \
	$(RTL_DIR)/Flatten.sv

RESULTS_ROOT ?= $(PROJECT_ROOT)/results_tb
RESULTS_DIR := $(abspath $(RESULTS_ROOT))/CNN_top/verilator
OBJ_DIR := $(RESULTS_DIR)/obj_dir
OBJ_DIR_COV := $(RESULTS_DIR)/obj_dir_cov
LOG_DIR := $(RESULTS_DIR)/logs
COV_DIR := $(RESULTS_DIR)/coverage
COV_DAT := $(COV_DIR)/cnn_top_coverage.dat
COV_RTL_DAT := $(COV_DIR)/cnn_top_rtl_coverage.dat
COV_FLOW_DAT := $(COV_DIR)/cnn_top_rtl_flow.dat
COV_FUNCTIONAL_DAT := $(COV_DIR)/cnn_top_functional.dat
COV_INFO := $(COV_DIR)/cnn_top_rtl.info
COV_FUNCTIONAL_INFO := $(COV_DIR)/cnn_top_functional.info
COV_SUMMARY := $(COV_DIR)/coverage_summary.log
COV_BINS := $(COV_DIR)/coverage_bins.log
COV_HTML := $(COV_DIR)/html
COV_FUNCTIONAL_HTML := $(COV_DIR)/functional_html
COV_EXIT := $(LOG_DIR)/coverage_exit_code.txt
WAVE := $(RESULTS_DIR)/tb_cnn_top_images.vcd

VERILATOR ?= verilator
VERILATOR_COVERAGE ?= verilator_coverage
LCOV ?= lcov
GENHTML ?= genhtml
PYTHON ?= python3
GTKWAVE ?= gtkwave
SURFER ?= surfer
JOBS ?= 2
OBJCACHE ?=
VERILATOR_FLAGS ?= -Wno-fatal
COVERAGE_PER_INSTANCE ?= 1

TEST ?= ALL
RANDOM_COUNT ?= 1000
SEED ?= 20261025
OBS_CYCLES ?= 64
EXPECTED_LATENCY ?= 0
ENABLE_WAVEFORM ?= 0
TRACE_EXPECTED ?= 0
PRINT_IMAGES ?= 0
PLUSARGS ?=

TB_ARGS = +TEST=$(TEST) +RANDOM_COUNT=$(RANDOM_COUNT) +SEED=$(SEED) \
	+OBS_CYCLES=$(OBS_CYCLES) +EXPECTED_LATENCY=$(EXPECTED_LATENCY) \
	$(if $(filter 1,$(ENABLE_WAVEFORM)),+DUMP_VCD) \
	$(if $(filter 1,$(TRACE_EXPECTED)),+TRACE_EXPECTED) \
	$(if $(filter 1,$(PRINT_IMAGES)),+PRINT_IMAGES) $(PLUSARGS)

COMMON_FLAGS = -sv --timing --assert --top-module $(TOP) $(VERILATOR_FLAGS)
BUILD_FLAGS = $(COMMON_FLAGS) --binary --trace --trace-depth 1 -j $(JOBS) \
	-MAKEFLAGS 'OBJCACHE=$(OBJCACHE)'
SOURCES = "$(CONTROL)" $(foreach source,$(DUT_FILES) $(TB),"$(source)")

.PHONY: all verilator check_tools check_report_tools check_files lint compile run \
	compile_cov _collect_cov run_cov report coverage coverage_summary html \
	wave waves gtk surf clean help
all: coverage
verilator: coverage

check_tools:
	@command -v "$(VERILATOR)" >/dev/null 2>&1 || \
		{ echo "ERRO: verilator nao encontrado no PATH" >&2; exit 1; }

check_report_tools: check_tools
	@command -v "$(VERILATOR_COVERAGE)" >/dev/null 2>&1 || \
		{ echo "ERRO: verilator_coverage nao encontrado no PATH" >&2; exit 1; }
	@command -v "$(GENHTML)" >/dev/null 2>&1 || \
		{ echo "ERRO: genhtml nao encontrado no PATH (pacote lcov)" >&2; exit 1; }
	@command -v "$(LCOV)" >/dev/null 2>&1 || \
		{ echo "ERRO: lcov nao encontrado no PATH" >&2; exit 1; }
	@command -v "$(PYTHON)" >/dev/null 2>&1 || \
		{ echo "ERRO: python3 nao encontrado no PATH" >&2; exit 1; }

check_files:
	@for source in $(foreach source,$(DUT_FILES) $(TB) $(CONTROL) $(COV_HELPER) $(COV_SPLITTER),"$(source)"); do \
		test -f "$$source" || { echo "ERRO: arquivo nao encontrado: $$source" >&2; exit 1; }; \
	done

lint: check_tools check_files
	@mkdir -p "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(COMMON_FLAGS) --lint-only $(SOURCES) 2>&1 | tee "$(LOG_DIR)/lint.log"

compile: check_tools check_files
	@mkdir -p "$(LOG_DIR)"
	@echo "[VERILATOR] Compilando CNN_top..."
	@set -o pipefail; \
	$(VERILATOR) $(BUILD_FLAGS) --Mdir "$(OBJ_DIR)" $(SOURCES) \
		2>&1 | tee "$(LOG_DIR)/compile.log"

run: compile
	@echo "[VERILATOR] TEST=$(TEST) SEED=$(SEED)"
	@set -o pipefail; ulimit -c 0; \
	cd "$(RESULTS_DIR)" && "$(OBJ_DIR)/V$(TOP)" $(TB_ARGS) \
		2>&1 | tee "$(LOG_DIR)/simulation.log"

compile_cov: check_tools check_files
	@mkdir -p "$(LOG_DIR)" "$(COV_DIR)"
	@$(VERILATOR) --version > "$(LOG_DIR)/verilator_version.log"
	@echo "[VERILATOR] Compilando cobertura estrutural de src e funcional do testbench..."
	@set -o pipefail; \
	$(VERILATOR) $(BUILD_FLAGS) --coverage \
		$(if $(filter 1,$(COVERAGE_PER_INSTANCE)),--coverage-per-instance) \
		-DCNN_TOP_VERILATOR_COVERAGE \
		--Mdir "$(OBJ_DIR_COV)" $(SOURCES) "$(COV_HELPER)" \
		2>&1 | tee "$(LOG_DIR)/compile_coverage.log"

# Alvo interno: guarda o status para gerar o relatorio mesmo se houver FAIL.
_collect_cov: compile_cov
	@rm -f "$(COV_DAT)" "$(COV_INFO)" "$(COV_SUMMARY)" "$(COV_EXIT)" \
		"$(COV_RTL_DAT)" "$(COV_FLOW_DAT)" "$(COV_FUNCTIONAL_DAT)" \
		"$(COV_FUNCTIONAL_INFO)" "$(COV_BINS)" "$(COV_DIR)/coverage_by_file.csv" \
		"$(COV_DIR)/functional_summary.log" "$(COV_DIR)/rtl_lcov_summary.log"
	@rm -rf -- "$(COV_HTML)" "$(COV_FUNCTIONAL_HTML)"
	@echo "[VERILATOR] Cobertura: TEST=$(TEST) SEED=$(SEED)"
	@set -o pipefail; ulimit -c 0; \
	cd "$(RESULTS_DIR)" || exit 1; \
	"$(OBJ_DIR_COV)/V$(TOP)" $(TB_ARGS) \
		"+COVERAGE_PATH=$(COV_DAT)" \
		"+verilator+coverage+file+$(COV_DAT)" \
		2>&1 | tee "$(LOG_DIR)/simulation_coverage.log"; \
	status=$$?; printf '%s\n' "$$status" > "$(COV_EXIT)"; \
	test -s "$(COV_DAT)" || \
		{ echo "ERRO: simulacao nao gerou cobertura; consulte simulation_coverage.log" >&2; exit 1; }

run_cov: _collect_cov
	@exit "$$(cat "$(COV_EXIT)")"

# Processa os dados existentes sem recompilar ou executar novamente.
report: check_report_tools
	@test -s "$(COV_DAT)" || { echo "ERRO: execute coverage ou run_cov primeiro" >&2; exit 1; }
	@mkdir -p "$(COV_DIR)"
	@$(PYTHON) "$(COV_SPLITTER)" --input "$(COV_DAT)" --rtl-root "$(RTL_DIR)" \
		--testbench "$(TB)" --output-dir "$(COV_DIR)"
	@set -o pipefail; \
	$(VERILATOR_COVERAGE) --annotate-min 1 --report summary "$(COV_RTL_DAT)" \
		2>&1 | tee "$(COV_SUMMARY)"
	@$(VERILATOR_COVERAGE) --annotate-min 1 --write-info "$(COV_INFO)" "$(COV_FLOW_DAT)"
	@set -o pipefail; \
	$(LCOV) --branch-coverage --summary "$(COV_INFO)" \
		2>&1 | tee "$(COV_DIR)/rtl_lcov_summary.log"
	@$(GENHTML) --branch-coverage --no-sourceview --legend \
		--title "CNN_top - cobertura RTL de src (linhas e ramos)" \
		--output-directory "$(COV_HTML)" "$(COV_INFO)" \
		> "$(LOG_DIR)/coverage_html.log" 2>&1
	@$(VERILATOR_COVERAGE) --annotate-min 1 --report summary "$(COV_FUNCTIONAL_DAT)" \
		> "$(COV_DIR)/functional_summary.log"
	@$(VERILATOR_COVERAGE) --annotate-min 1 --report hier "$(COV_FUNCTIONAL_DAT)" > "$(COV_BINS)"
	@$(VERILATOR_COVERAGE) --annotate-min 1 --write-info "$(COV_FUNCTIONAL_INFO)" "$(COV_FUNCTIONAL_DAT)"
	@$(GENHTML) --branch-coverage --no-sourceview --legend \
		--title "CNN_top - bins funcionais do testbench" \
		--output-directory "$(COV_FUNCTIONAL_HTML)" "$(COV_FUNCTIONAL_INFO)" \
		> "$(LOG_DIR)/functional_html.log" 2>&1
	@echo "HTML RTL (src): $(COV_HTML)/index.html"
	@echo "Resumo RTL por tipo: $(COV_SUMMARY)"
	@echo "Resumo RTL por arquivo: $(COV_DIR)/coverage_by_file.csv"
	@echo "HTML funcional: $(COV_FUNCTIONAL_HTML)/index.html"
	@echo "Resultado funcional da simulacao permanece em simulation_coverage.log."

coverage: check_report_tools _collect_cov
	@$(MAKE) --no-print-directory -f "$(THIS_MAKEFILE)" report
	@exit "$$(cat "$(COV_EXIT)")"

coverage_summary html: report

wave:
	@$(MAKE) --no-print-directory -f "$(THIS_MAKEFILE)" run ENABLE_WAVEFORM=1
	@echo "WAVE: $(WAVE)"
waves: wave
gtk: wave
	@$(GTKWAVE) "$(WAVE)"
surf: wave
	@$(SURFER) "$(WAVE)"

clean:
	@rm -rf -- "$(RESULTS_DIR)"
	@echo "[CLEAN] Resultados CNN_top/Verilator removidos."

help:
	@echo "CNN_top / Verilator: coverage (padrao), compile, run, lint, compile_cov, run_cov, report"
	@echo "  bash scripts/testbenchs/bash/CNN_top/cnn_top_verilator.sh"
	@echo "  bash scripts/testbenchs/bash/CNN_top/cnn_top_verilator.sh coverage TEST=IMG-01"
	@echo "  bash scripts/testbenchs/bash/CNN_top/cnn_top_verilator.sh wave TEST=IMG-01"
	@echo "Outros alvos: wave, waves, gtk, surf, clean, help."
	@echo "Variaveis: TEST, RANDOM_COUNT, SEED, OBS_CYCLES, EXPECTED_LATENCY,"
	@echo "           TRACE_EXPECTED, PRINT_IMAGES, ENABLE_WAVEFORM, PLUSARGS,"
	@echo "           DUT_FILES, RTL_DIR, RESULTS_ROOT, JOBS, OBJCACHE, VERILATOR_FLAGS,"
	@echo "           COVERAGE_PER_INSTANCE (padrao 1)."
	@echo "Resultados: $(RESULTS_DIR)"
	@echo "Relatorio principal: cobertura estrutural dos arquivos de src elaborados na CNN."
	@echo "Os bins funcionais do testbench sao publicados em relatorio separado."
	@echo "FAIL gera relatorio e retorna erro; INCOMPLETE continua identificado no log."
