# ==============================================================================
# Makefile - DotProduct / Verilator + cobertura LCOV/HTML
# Projeto: CNN
# ==============================================================================

SHELL := /bin/bash
.DEFAULT_GOAL := all

# ==============================================================================
# FERRAMENTAS
# ==============================================================================

VERILATOR          ?= verilator
VERILATOR_COVERAGE ?= verilator_coverage
LCOV                ?= lcov
GENHTML             ?= genhtml
GTKWAVE             ?= gtkwave
SURFER              ?= surfer

# ==============================================================================
# DIRETÓRIOS
# ==============================================================================

THIS_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
MAKEFILE_DIR  := $(dir $(THIS_MAKEFILE))
PROJECT_ROOT  := $(abspath $(MAKEFILE_DIR)/../../..)

RTL_DIR := $(PROJECT_ROOT)/src/DotProduct
TB_DIR  := $(PROJECT_ROOT)/testbenchs/DOT

RESULTS_ROOT ?= $(PROJECT_ROOT)/results_tb
RESULTS_DIR  := $(RESULTS_ROOT)/DOT/verilator

OBJ_DIR     := $(RESULTS_DIR)/obj_dir
OBJ_DIR_COV := $(RESULTS_DIR)/obj_dir_cov

# ==============================================================================
# ARQUIVOS
# ==============================================================================

RTL := $(RTL_DIR)/DotProduct.sv
TB  := $(TB_DIR)/testbench.sv

# O testbench define esse nome em $dumpfile().
WAVE := $(RESULTS_DIR)/DotProduct_tb.vcd

# Logs
LOG_DIR         := $(RESULTS_DIR)/logs
LINT_LOG        := $(LOG_DIR)/lint.log
COMPILE_LOG     := $(LOG_DIR)/compile.log
SIM_LOG         := $(LOG_DIR)/simulation.log
COMPILE_COV_LOG := $(LOG_DIR)/compile_coverage.log
SIM_COV_LOG     := $(LOG_DIR)/simulation_coverage.log

# Cobertura
COV_DIR      := $(RESULTS_DIR)/coverage
COV_DAT      := $(COV_DIR)/dotproduct_coverage.dat
COV_INFO_RAW := $(COV_DIR)/dotproduct_coverage_raw.info
COV_INFO_RTL := $(COV_DIR)/dotproduct_coverage.info
COV_HTML     := $(COV_DIR)/html
COV_SUMMARY  := $(COV_DIR)/coverage_summary.log

# Lint waiver
LINT_WAIVER     ?=
LINT_WAIVER_OPT := $(if $(strip $(LINT_WAIVER)),$(LINT_WAIVER),)
LINT_WAIVER_OUT ?= $(RESULTS_DIR)/verilator_lint.vlt

# ==============================================================================
# PROJETO DOTPRODUCT
# ==============================================================================

TOP     := testbench
RTL_TOP := DotProduct

# Argumentos opcionais enviados ao executável.
RUN_ARGS ?=

# Parâmetros existentes no testbench.
ENABLE_WAVEFORM ?= 0
ENABLE_MONITOR  ?= 0

TB_PARAM_FLAGS := \
	-GENABLE_WAVEFORM=$(ENABLE_WAVEFORM) \
	-GENABLE_MONITOR=$(ENABLE_MONITOR)

COV_RUN_ARGS := $(RUN_ARGS) +verilator+coverage+file+$(COV_DAT)

# ==============================================================================
# PARALELISMO
# ==============================================================================

JOBS ?= $(shell nproc 2>/dev/null || getconf _NPROCESSORS_ONLN 2>/dev/null || echo 1)

# ==============================================================================
# INCLUDES
# ==============================================================================

INC := \
	+incdir+$(TB_DIR) \
	+incdir+$(RTL_DIR) \
	+incdir+$(PROJECT_ROOT)/src

# ==============================================================================
# FLAGS DO VERILATOR
# ==============================================================================

VFLAGS_COMMON := \
	-sv \
	--binary \
	--timing \
	-j $(JOBS) \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	--trace \
	$(INC) \
	--top-module $(TOP) \
	$(TB_PARAM_FLAGS)

VFLAGS := \
	$(VFLAGS_COMMON) \
	--Mdir $(OBJ_DIR)

VFLAGS_COV := \
	$(VFLAGS_COMMON) \
	--coverage \
	--Mdir $(OBJ_DIR_COV)

LINT_FLAGS := \
	-sv \
	--lint-only \
	--timing \
	-j $(JOBS) \
	-Wall \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	$(INC) \
	--top-module $(TOP) \
	$(TB_PARAM_FLAGS)

LINT_RTL_FLAGS := \
	-sv \
	--lint-only \
	--timing \
	-j $(JOBS) \
	-Wall \
	-Wno-fatal \
	-Wno-WIDTHTRUNC \
	-Wno-WIDTHEXPAND \
	+incdir+$(RTL_DIR) \
	--top-module $(RTL_TOP)

# ==============================================================================
# TARGETS
# ==============================================================================

.PHONY: all \
	check_verilator check_tools check_html_tools check_files check_lint_waiver \
	lint lint_rtl lint_waiver \
	compile run compile_cov run_cov \
	lcov_raw lcov_rtl coverage_summary html_rtl coverage \
	waves surf clean help

all: coverage

# ==============================================================================
# VERIFICAÇÕES
# ==============================================================================

check_verilator:
	@command -v $(VERILATOR) >/dev/null 2>&1 || \
		( echo "ERRO: verilator nao encontrado no PATH"; exit 1 )

check_tools:
	@command -v $(VERILATOR) >/dev/null 2>&1 || \
		( echo "ERRO: verilator nao encontrado no PATH"; exit 1 )
	@command -v $(VERILATOR_COVERAGE) >/dev/null 2>&1 || \
		( echo "ERRO: verilator_coverage nao encontrado no PATH"; exit 1 )
	@command -v $(LCOV) >/dev/null 2>&1 || \
		( echo "ERRO: lcov nao encontrado no PATH"; exit 1 )

check_html_tools:
	@command -v $(GENHTML) >/dev/null 2>&1 || \
		( echo "ERRO: genhtml nao encontrado no PATH (instale o pacote lcov)"; exit 1 )

check_files:
	@test -f "$(RTL)" || \
		( echo "ERRO: RTL do DotProduct nao encontrado:"; echo "$(RTL)"; exit 1 )
	@test -f "$(TB)" || \
		( echo "ERRO: testbench do DotProduct nao encontrado:"; echo "$(TB)"; exit 1 )

check_lint_waiver:
	@if [ -n "$(LINT_WAIVER)" ]; then \
		test -f "$(LINT_WAIVER)" || \
		( echo "ERRO: arquivo de waiver nao encontrado: $(LINT_WAIVER)"; exit 1 ); \
	fi

# ==============================================================================
# LINT
# ==============================================================================

lint: check_verilator check_files check_lint_waiver
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(LINT_WAIVER_OPT) $(LINT_FLAGS) "$(RTL)" "$(TB)" \
		2>&1 | tee "$(LINT_LOG)"

lint_rtl: check_verilator check_files check_lint_waiver
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@set -o pipefail; \
	$(VERILATOR) $(LINT_WAIVER_OPT) $(LINT_RTL_FLAGS) "$(RTL)" \
		2>&1 | tee "$(LINT_LOG)"

lint_waiver: check_verilator check_files
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	$(VERILATOR) $(LINT_FLAGS) --waiver-output "$(LINT_WAIVER_OUT)" "$(RTL)" "$(TB)"
	@echo "Waiver inicial gerado em: $(LINT_WAIVER_OUT)"

# ==============================================================================
# SIMULAÇÃO NORMAL
# ==============================================================================

compile: lint check_verilator
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Compilando DotProduct..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	$(VERILATOR) $(VFLAGS) "$(RTL)" "$(TB)" \
		2>&1 | tee "$(COMPILE_LOG)"

run: compile
	@mkdir -p "$(RESULTS_DIR)" "$(LOG_DIR)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Executando DotProduct..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	cd "$(RESULTS_DIR)" && \
	"$(OBJ_DIR)/V$(TOP)" $(RUN_ARGS) \
		2>&1 | tee "$(SIM_LOG)"

# ==============================================================================
# SIMULAÇÃO COM COBERTURA
# ==============================================================================

compile_cov: check_tools check_files
	@mkdir -p "$(RESULTS_DIR)" "$(COV_DIR)" "$(LOG_DIR)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Compilando cobertura..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	$(VERILATOR) $(VFLAGS_COV) "$(RTL)" "$(TB)" \
		2>&1 | tee "$(COMPILE_COV_LOG)"

run_cov: compile_cov
	@mkdir -p "$(RESULTS_DIR)" "$(COV_DIR)" "$(LOG_DIR)"
	@rm -f "$(COV_DAT)" "$(COV_INFO_RAW)" "$(COV_INFO_RTL)" "$(COV_SUMMARY)"
	@echo ""
	@echo "========================================"
	@echo "[VERILATOR] Executando cobertura..."
	@echo "========================================"
	@echo ""
	@set -o pipefail; \
	cd "$(RESULTS_DIR)" && \
	"$(OBJ_DIR_COV)/V$(TOP)" $(COV_RUN_ARGS) \
		2>&1 | tee "$(SIM_COV_LOG)"

# ==============================================================================
# RELATÓRIO DE COBERTURA
# ==============================================================================

lcov_raw: run_cov
	$(VERILATOR_COVERAGE) --write-info "$(COV_INFO_RAW)" "$(COV_DAT)"
	@echo "LCOV bruto: $(COV_INFO_RAW)"

lcov_rtl: lcov_raw
	$(LCOV) \
		--extract "$(COV_INFO_RAW)" "$(RTL_DIR)/*" \
		-o "$(COV_INFO_RTL)"
	@echo "LCOV RTL-only: $(COV_INFO_RTL)"

coverage_summary: lcov_rtl
	@set -o pipefail; \
	$(LCOV) --summary "$(COV_INFO_RTL)" \
		2>&1 | tee "$(COV_SUMMARY)"

html_rtl: coverage_summary check_html_tools
	@rm -rf "$(COV_HTML)"
	@mkdir -p "$(COV_HTML)"
	$(GENHTML) \
		--flat \
		--legend \
		--prefix "$(PROJECT_ROOT)/" \
		--source-directory "$(PROJECT_ROOT)" \
		-o "$(COV_HTML)" \
		"$(COV_INFO_RTL)"
	@echo ""
	@echo "========================================"
	@echo "[OK] Relatorio de cobertura DotProduct"
	@echo "========================================"
	@echo "HTML: $(COV_HTML)/index.html"
	@echo "Resumo: $(COV_SUMMARY)"
	@echo ""

coverage: html_rtl

# ==============================================================================
# WAVEFORM
# ==============================================================================

waves:
	@$(MAKE) -f "$(THIS_MAKEFILE)" run ENABLE_WAVEFORM=1 ENABLE_MONITOR=$(ENABLE_MONITOR)
	@if [ -f "$(WAVE)" ]; then \
		$(GTKWAVE) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi

surf:
	@$(MAKE) -f "$(THIS_MAKEFILE)" run ENABLE_WAVEFORM=1 ENABLE_MONITOR=$(ENABLE_MONITOR)
	@if [ -f "$(WAVE)" ]; then \
		$(SURFER) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi

# ==============================================================================
# LIMPEZA
# ==============================================================================

clean:
	@echo "[CLEAN] Removendo resultados Verilator do DotProduct..."
	@rm -rf "$(RESULTS_DIR)"
	@echo "[OK] Resultados removidos."

# ==============================================================================
# AJUDA
# ==============================================================================

help:
	@echo ""
	@echo "Makefile - DotProduct / Verilator"
	@echo ""
	@echo "Comandos:"
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR"
	@echo "      Executa cobertura completa e gera HTML"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR lint"
	@echo "      Lint da bancada + RTL"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR lint_rtl"
	@echo "      Lint apenas de src/DotProduct/DotProduct.sv"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR run"
	@echo "      Compila e executa sem cobertura"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR coverage"
	@echo "      Gera cobertura LCOV + HTML"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR waves"
	@echo "      Executa com waveform e abre GTKWave"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR surf"
	@echo "      Executa com waveform e abre Surfer"
	@echo ""
	@echo "  make -f scripts/testbenchs/makefiles/Makefile_dot_VERILATOR clean"
	@echo "      Remove results_tb/DOT/verilator"
	@echo ""
