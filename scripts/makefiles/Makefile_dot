# ==============================================================================
# Makefile - DotProduct / Icarus Verilog
# Projeto: CNN
# ==============================================================================

SHELL := /bin/bash
.DEFAULT_GOAL := all

# ==============================================================================
# DIRETÓRIOS
# ==============================================================================

THIS_MAKEFILE := $(abspath $(lastword $(MAKEFILE_LIST)))
MAKEFILE_DIR  := $(dir $(THIS_MAKEFILE))
PROJECT_ROOT  := $(abspath $(MAKEFILE_DIR)/../..)

RTL_DIR := $(PROJECT_ROOT)/src/DotProduct
TB_DIR  := $(PROJECT_ROOT)/testbenchs/DOT

RESULTS_DIR := $(PROJECT_ROOT)/results/DOT/icarus

# ==============================================================================
# ARQUIVOS
# ==============================================================================

RTL := $(RTL_DIR)/DotProduct.sv
TB  := $(TB_DIR)/testbench.sv

VVP_FILE := $(RESULTS_DIR)/dotproduct.vvp

COMPILE_LOG := $(RESULTS_DIR)/compile.log
SIM_LOG     := $(RESULTS_DIR)/simulation.log

# O testbench define o nome abaixo em $dumpfile().
# O formato efetivo pode ser VCD/FST conforme VVP_FLAGS.
WAVE := $(RESULTS_DIR)/DotProduct_tb.vcd

# ==============================================================================
# TOP LEVEL
# ==============================================================================

TOP := testbench

# ==============================================================================
# FERRAMENTAS
# ==============================================================================

IVERILOG ?= iverilog
VVP      ?= vvp
GTKWAVE  ?= gtkwave
SURFER   ?= surfer

# ==============================================================================
# CONTROLE DO TESTBENCH
# ==============================================================================

# Correspondem aos parâmetros existentes em testbenchs/DOT/testbench.sv.
ENABLE_WAVEFORM ?= 0
ENABLE_MONITOR  ?= 0

TB_PARAM_FLAGS := \
	-P$(TOP).ENABLE_WAVEFORM=$(ENABLE_WAVEFORM) \
	-P$(TOP).ENABLE_MONITOR=$(ENABLE_MONITOR)

# ==============================================================================
# FLAGS
# ==============================================================================

IVERILOG_FLAGS := \
	-Wall \
	-g2012 \
	-I"$(RTL_DIR)" \
	-I"$(PROJECT_ROOT)/src" \
	-s $(TOP) \
	$(TB_PARAM_FLAGS)

# Deixe vazio para VCD padrão.
# Se desejar forçar FST no Icarus, execute:
#   make -f scripts/makefiles/Makefile_dot run ENABLE_WAVEFORM=1 VVP_FLAGS=-fst
VVP_FLAGS ?=

# ==============================================================================
# TARGETS
# ==============================================================================

.PHONY: all icarus check_tools check_files compile run wave gtk surf clean help

all: icarus

icarus: run

# ==============================================================================
# VERIFICAÇÕES
# ==============================================================================

check_tools:
	@command -v $(IVERILOG) >/dev/null 2>&1 || \
		( echo "ERRO: iverilog nao encontrado no PATH"; exit 1 )
	@command -v $(VVP) >/dev/null 2>&1 || \
		( echo "ERRO: vvp nao encontrado no PATH"; exit 1 )

check_files:
	@test -f "$(RTL)" || \
		( echo "ERRO: RTL do DotProduct nao encontrado:"; echo "$(RTL)"; exit 1 )
	@test -f "$(TB)" || \
		( echo "ERRO: testbench do DotProduct nao encontrado:"; echo "$(TB)"; exit 1 )

# ==============================================================================
# COMPILAÇÃO
# ==============================================================================

compile: check_tools check_files
	@mkdir -p "$(RESULTS_DIR)"
	@echo ""
	@echo "========================================"
	@echo "[IVERILOG] Compilando DotProduct..."
	@echo "========================================"
	@echo ""

	@set -o pipefail; \
	$(IVERILOG) \
		$(IVERILOG_FLAGS) \
		-o "$(VVP_FILE)" \
		"$(RTL)" \
		"$(TB)" \
		2>&1 | tee "$(COMPILE_LOG)"

	@echo ""
	@echo "[OK] Compilacao concluida"
	@echo "VVP : $(VVP_FILE)"
	@echo "LOG : $(COMPILE_LOG)"
	@echo ""

# ==============================================================================
# SIMULAÇÃO
# ==============================================================================

run: compile
	@echo ""
	@echo "========================================"
	@echo "[VVP] Executando DotProduct..."
	@echo "========================================"
	@echo ""

	@set -o pipefail; \
	cd "$(RESULTS_DIR)" && \
	$(VVP) "$(VVP_FILE)" $(VVP_FLAGS) \
		2>&1 | tee "$(SIM_LOG)"

	@echo ""
	@echo "========================================"
	@echo "[OK] Simulacao concluida"
	@echo "========================================"
	@echo "LOG : $(SIM_LOG)"
	@echo ""

# ==============================================================================
# WAVEFORM
# ==============================================================================

wave:
	@$(MAKE) -f "$(THIS_MAKEFILE)" run VVP_FLAGS="+waveform" ENABLE_MONITOR=$(ENABLE_MONITOR)
	@echo "WAVE: $(WAVE)"

gtk: wave
	@echo ""
	@if [ -f "$(WAVE)" ]; then \
		$(GTKWAVE) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi

surf: wave
	@echo ""
	@if [ -f "$(WAVE)" ]; then \
		$(SURFER) "$(WAVE)"; \
	else \
		echo "ERRO: waveform nao encontrada:"; \
		echo "$(WAVE)"; \
		exit 1; \
	fi

# ==============================================================================
# LIMPEZA
# ==============================================================================

clean:
	@echo "[CLEAN] Removendo resultados Icarus do DotProduct..."
	@rm -rf "$(RESULTS_DIR)"
	@echo "[OK] Resultados removidos."

# ==============================================================================
# AJUDA
# ==============================================================================

help:
	@echo ""
	@echo "Makefile - DotProduct / Icarus"
	@echo ""
	@echo "Comandos:"
	@echo "  make -f scripts/makefiles/Makefile_dot"
	@echo "      Compila e executa o testbench"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot compile"
	@echo "      Apenas compila"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot run"
	@echo "      Compila e executa"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot gtk"
	@echo "      Executa com waveform e abre GTKWave"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot wave"
	@echo "      Gera waveform sem abrir um visualizador"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot surf"
	@echo "      Executa com waveform e abre Surfer"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot run ENABLE_MONITOR=1"
	@echo "      Habilita o monitor do testbench"
	@echo ""
	@echo "  make -f scripts/makefiles/Makefile_dot clean"
	@echo "      Remove results/DOT/icarus"
	@echo ""
