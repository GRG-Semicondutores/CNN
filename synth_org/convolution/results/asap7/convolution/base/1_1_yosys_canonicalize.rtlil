    parameter \ARST_VALUE 180'x
    parameter \SRST_VALUE 180'x
    parameter \INIT_VALUE 180'x
    parameter \ABITS 32
    parameter \WIDTH 180
    connect \CLK 1'x
    connect \EN 1'1
    connect \ARST 1'0
    connect \SRST 1'0
    connect \ADDR 1
    connect \DATA $114
  end
  connect $137 [179:160] \out
  connect \valid_out \valid_pipe [4]
end
